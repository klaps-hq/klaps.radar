# Klaps API
API_URL=http://localhost:5000/api/v2
INTERNAL_API_KEY=your-secret-api-key

# Instagram (required)
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_USER_ID=your-instagram-user-id

# Facebook (optional, jobs are skipped when unset)
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-token

# Threads (optional, job is skipped when unset)
THREADS_USER_ID=your-threads-user-id
THREADS_ACCESS_TOKEN=your-threads-token

# Cron overrides (optional, defaults shown)
# IG_POST_CRON=30 11 * * 0,1,5
# IG_REEL_CLASSIC_CRON=30 18 * * 2
# IG_REEL_WEEKEND_CRON=30 18 * * 4
# IG_REEL_SUNDAY_CRON=30 18 * * 6
# IG_CAROUSEL_CRON=30 11 * * 3
# IG_STORY_CRON=30 8,17 * * *
# FB_POST_CRON=0 13 * * *
# FB_STORY_CRON=45 8,17 * * *
# THREADS_POST_CRON=30 18 * * *

# Tuning (optional, defaults shown)
# STORIES_PER_DAY=2
# PUBLISH_JITTER_MINUTES=0

# Token persistence (optional). When unset, refreshed tokens are written
# back into .env; in Docker these point at files on the /data volume.
# INSTAGRAM_TOKEN_FILE=/data/instagram-token
# THREADS_TOKEN_FILE=/data/threads-token

# Optional: TMDB textless key art and extra stills for posts and reels.
# Without it the renderers use the DB poster/backdrop only.
TMDB_API_KEY=

# Optional: Gemini picks the most recognisable still/poster and its focal
# point among the TMDB candidates. Needs a model with image input. Without
# it the image choice falls back to the local heuristics only.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent

# Local only: regenerates the reel audio library (src/scripts/generate-audio.ts).
# Not needed in production, the files are committed under assets/audio.
ELEVENLABS_API_KEY=
